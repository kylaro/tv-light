; WS2812 driver: one bit per 10 PIO cycles, 24 bits per LED shifted MSB first.
.program ws2812
.side_set 1

.define public T1 3
.define public T2 3
.define public T3 4

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1] ; side-set still happens when out stalls
    jmp !x do_zero side 1 [T1 - 1] ; start of every bit: drive high
do_one:
    jmp  bitloop   side 1 [T2 - 1] ; a 1 stays high for a long pulse
do_zero:
    nop            side 0 [T2 - 1] ; a 0 drops low early
.wrap
